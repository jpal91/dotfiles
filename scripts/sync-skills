#!/usr/bin/env python

from configparser import ConfigParser
from pathlib import Path

DOTFILES = Path("~/.dotfiles").expanduser()
DF_SKILLS = DOTFILES / "skills"
DOTTER_DIR = DOTFILES / ".dotter"
SKILLS_DIR = Path("~/.agents/skills").expanduser()

installed_skills = (
    [sdir.name for sdir in SKILLS_DIR.iterdir() if not sdir.is_symlink()]
    if SKILLS_DIR.exists()
    else []
)

with open(DF_SKILLS / "installed-skills.txt", "w") as f:
    f.write("\n".join(installed_skills))

dotfiles_skills = (
    [ddir.name for ddir in DF_SKILLS.iterdir() if ddir.is_dir()]
    if DF_SKILLS.exists()
    else []
)

home = str(Path("~").expanduser())
config = ConfigParser()
config.read(DOTTER_DIR / "global.toml")

for skill in dotfiles_skills:
    name = f'"skills/{skill}"'
    if name in config["skills.files"]:
        continue

    file_target = str(SKILLS_DIR / skill).replace(home, "~")
    config.set("skills.files", name, f'"{file_target}"')

with open(DOTTER_DIR / "global.toml", "w") as f:
    config.write(f)
